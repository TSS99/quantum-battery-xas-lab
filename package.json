{
  "name": "quantum-battery-xas-lab",
  "version": "1.20.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack && node scripts/flatten-segments.mjs && node scripts/make-sw.mjs",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "playwright test",
    "science": "python -m uvicorn science.app:app --host 127.0.0.1 --port 8000",
    "twin": "esbuild src/cli/twin-cli.ts --bundle --platform=node --format=esm --outfile=.cache/twin-cli.mjs --log-level=warning && node .cache/twin-cli.mjs",
    "mcp": "esbuild src/cli/xaslab-mcp.ts --bundle --platform=node --format=esm --outfile=.cache/xaslab-mcp.mjs --log-level=warning && node .cache/xaslab-mcp.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "desktop": "tauri build"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.4.0",
    "@react-three/postprocessing": "^3.0.4",
    "katex": "0.16.47",
    "lucide-react": "^0.468.0",
    "ml-matrix": "^6.12.0",
    "motion": "^12.23.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@tauri-apps/cli": "2.12.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "axe-core": "4.10.2",
    "esbuild": "0.28.2",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
